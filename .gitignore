# Secrets — never commit
.env
.env.*
!.env.example

# Data caches (large; rebuilt by `python -m ontime.ingest`)
data/
*.zip
*.sqlite
*.sqlite-journal
# ...but test fixtures are tracked: they are the reproducible inputs.
!tests/fixtures/*.zip

# Nix / direnv
.direnv/
result
result-*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# macOS
.DS_Store
